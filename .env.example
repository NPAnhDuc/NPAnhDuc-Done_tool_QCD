# Jira (internal VinFast server)
JIRA_API_TOKEN=your_jira_token_here
JIRA_URL=https://tms.vinfast.vn
JIRA_PROJECT_KEY=VF6

# AI Engine: vLLM (ưu tiên - nội bộ công ty, bảo mật)
# Khi IT cung cấp URL thì điền vào, code sẽ tự dùng vLLM
VLLM_BASE_URL=
VLLM_MODEL=qwen3

# Gemini AI (fallback khi chưa có vLLM)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Local AI (dùng nếu self-host ở nhà)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen2.5:14b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector Database: Qdrant (local mode - không cần Docker)
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION=jira_issues_v5
EMBED_DIM=768